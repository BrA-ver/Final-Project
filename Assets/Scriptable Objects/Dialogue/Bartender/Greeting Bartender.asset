  m_Script: {fileID: 11500000, guid: 7b59aca2b9aa96b4694ef68a6119afa9, type: 3}
  m_Name: Greeting Bartender
  m_EditorClassIdentifier: 
  _name: Bartender
  Speaker: Bartender
  lines:
  - Never in my life would I have imagined seeing something like this
  choices:
  - text: Tell me about yourself?
    targetDialogue: {fileID: 11400000, guid: 791da7ac3e7a37041bc5c2b7213f9527, type: 2}
  - text: How did you feel about James?
    targetDialogue: {fileID: 11400000, guid: 5cfe92f6eade8b043a9d70c0de290e46, type: 2}
  - text: What were you doing between 13:30 and 14:00?
    targetDialogue: {fileID: 11400000, guid: 74ca0fbba8471a348b9715f2a88a363a, type: 2}
  - text: Do you know of anyone who had a problem with James?
    targetDialogue: {fileID: 11400000, guid: 1a02d175f73b1ae4f852e56b0b0e963d, type: 2}
  - text: 'Have you ever had any relationships with performers here? '
    targetDialogue: {fileID: 11400000, guid: be4e672ae210c824385b455f8c7ffe7e, type: 2}
  - text: I'll talk to you later
    targetDialogue: {fileID: 11400000, guid: f7324ede1f03acb42b6ed0831116180e, type: 2}
  evidence: {fileID: 0}
