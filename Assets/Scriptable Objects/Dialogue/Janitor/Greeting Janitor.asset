  m_Script: {fileID: 11500000, guid: 7b59aca2b9aa96b4694ef68a6119afa9, type: 3}
  m_Name: Greeting Janitor
  m_EditorClassIdentifier: 
  _name: Janitor
  Speaker: Janitor
  lines:
  - Never in my life would I have imagined seeing something like this
  choices:
  - text: Tell me about yourself?
    targetDialogue: {fileID: 11400000, guid: 5f7531bd0f3d271428ad485c97ccf983, type: 2}
  - text: How did you feel about James?
    targetDialogue: {fileID: 11400000, guid: 3d54d6708d99f0944a3790dda8d9c6c0, type: 2}
  - text: What were you doing between 13:30 and 14:00?
    targetDialogue: {fileID: 11400000, guid: 06539d8e9f3d7b94ba38f61a127cc4aa, type: 2}
  - text: Do you know of anyone who had a problem with James?
    targetDialogue: {fileID: 11400000, guid: 9edf3bd596afcca40aea95827b6fb4ec, type: 2}
  - text: Did you dispose of anything out of the ordinary today?
    targetDialogue: {fileID: 11400000, guid: 0a39565115c515843b141ae66c22ea31, type: 2}
  - text: I'll talk to you later.
    targetDialogue: {fileID: 11400000, guid: 3cce54a9444259541ae2cbac5f392802, type: 2}
  evidence: {fileID: 0}
