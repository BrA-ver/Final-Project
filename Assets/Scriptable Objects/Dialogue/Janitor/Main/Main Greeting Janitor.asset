  m_Name: Main Greeting Janitor
  m_EditorClassIdentifier: 
  _name: Janitor
  Speaker: Janitor
  lines:
  - Hello, Detective how can I help?
  - 'Detective: Hello Mister Antonio. I have some questions for you.'
  choices:
  - text: I need to confirm some information about you for my report.
    targetDialogue: {fileID: 11400000, guid: 5f7531bd0f3d271428ad485c97ccf983, type: 2}
  - text: "What were you doing between one thirty (13:30) and three o\u2019clock
      (15:00)?"
    targetDialogue: {fileID: 11400000, guid: 06539d8e9f3d7b94ba38f61a127cc4aa, type: 2}
  - text: What did you think about Mister James, the performer that died?
    targetDialogue: {fileID: 11400000, guid: 3d54d6708d99f0944a3790dda8d9c6c0, type: 2}
  - text: Do you know of anyone who had a problem with James?
    targetDialogue: {fileID: 11400000, guid: 9edf3bd596afcca40aea95827b6fb4ec, type: 2}
  - text: That everything for now I will come by again if I have any more questions.
    targetDialogue: {fileID: 11400000, guid: 3cce54a9444259541ae2cbac5f392802, type: 2}
  isExit: 0
  evidence: {fileID: 0}
