  m_Script: {fileID: 11500000, guid: 7b59aca2b9aa96b4694ef68a6119afa9, type: 3}
  m_Name: Bartender Poison Q
  m_EditorClassIdentifier: 
  _name: 
  Speaker: 
  lines:
  - 'Detective: Ms Lisa, I found this empty bottle of arsenic in your locker. You
    know this is a medice that is very lethal when ingested. So why do you have it.'
  - 'Lisa: Yes, detective I know it is, but I have permission to use it because I
    have APL (acute promyelocytic leukemia). That is why it was in my locker so that
    it could not be use by anyone else.'
